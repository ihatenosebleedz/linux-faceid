     property bool authenticating: false
     property string errorMessage: ""
     property int failLockSecondsLeft: 0
+    property bool faceIdArmed: false
+
+    // ---- Face ID unlock (community.linux-faceid) ----
+    // A button next to the password field requests a one-shot face scan; a
+    // match unlocks exactly like a correct password. No match leaves the
+    // password box ready. Locking via loginctl never touches
+    // GlobalStates.lockscreenVisible, so no re-arm-on-lock logic is used here:
+    // the button just clears stale state and fires a fresh auth each click.
+    function triggerFaceScan() {
+        if (!Config.lockscreen.faceId) return;
+        if (!FaceIdService.enrolled) return;
+        if (FaceIdService.authStatus === "pending") return;
+        FaceIdService.authStatus = "idle";
+        root.faceIdArmed = true;
+        FaceIdService.auth();
+    }
+
+    Connections {
+        target: FaceIdService
+        function onAuthStatusChanged() {
+            if (FaceIdService.authStatus === "success" && root.faceIdArmed) {
+                root.faceIdArmed = false;
+                authPasswordHolder.password = "";
+                startAnim = false;
+                unlockTimer.start();
+                errorMessage = "";
+                authenticating = false;
+            } else if (FaceIdService.authStatus === "failed") {
+                root.faceIdArmed = false;
+            }
+        }
+    }
 
     // Always transparent - blur background handles the visuals
     color: "transparent"
